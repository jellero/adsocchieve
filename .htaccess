# Apache: rende accessibili gli URL pubblici senza estensione (es. /privacy).
# Ignorato da GitHub Pages e Nginx; su Nginx configurare l'equivalente try_files.
DirectoryIndex index.html
RewriteEngine On
# Canonical host: reindirizza il dominio senza www alla versione HTTPS con www.
RewriteCond %{HTTP_HOST} ^albergodiffusosocchieve\.it$ [NC]
RewriteRule ^(.*)$ https://www.albergodiffusosocchieve.it/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html
